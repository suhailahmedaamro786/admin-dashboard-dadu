# Client-safe (Vite exposes only VITE_* variables to browser code)
VITE_PUBLIC_SURVEY_URL=https://dadu-business-insights.vercel.app/

# Server-only secrets/configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-real-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Existing PostgreSQL database used by Dadu-Business-Insights.
# Use the existing connection string; do not create a new database.
DATABASE_URL=
# Optional alternative connection string if DATABASE_URL is not used:
POSTGRES_URL=

# Optional split PostgreSQL credentials if the platform does not provide a URL:
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

NODE_ENV=production
PORT=3000
